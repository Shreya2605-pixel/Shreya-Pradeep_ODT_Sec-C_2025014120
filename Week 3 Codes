#While loop
from machine import Pin
import time
B = Pin(2,Pin.OUT)
C = 3
while C > 0 :
    B.on()
    time.sleep(1)
    B.off
    time.sleep(1)
    C = C - 1

#Multiple (4) LEDs at a time, continuously
from machine import Pin
import time
Y = Pin(12,Pin.OUT)
R = Pin(2,Pin.OUT)
B = Pin(4,Pin.OUT)
G = Pin(5,Pin.OUT)
while True:
    Y.on()
    time.sleep(1)
    Y.off()
    time.sleep(1)
    R.on()
    time.sleep(1)
    R.off()
    time.sleep(1)
    B.on()
    time.sleep(1)
    B.off()
    time.sleep(1)
    G.on()
    time.sleep(1)
    G.off()
    
