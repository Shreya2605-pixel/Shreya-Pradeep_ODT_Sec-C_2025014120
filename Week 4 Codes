#If Loops
from machine import Pin, TouchPad
import time
T = TouchPad(Pin(12))
A = Pin(4,Pin.OUT)
while True:
    T_value = T.read() #will read the value of the Pin
    if T_value < 500: #when touched
        print("Pin Touched")
        A.on()
        time.sleep(0.5) #will make it glow for 0.5 second
    A.off() #once if loop is done
    print("Not Touched") #will happen when if loop is over (or if loop is false)
    time.sleep(0.2)

#If Loop with else
from machine import Pin, TouchPad
import time
T = TouchPad(Pin(12))
A = Pin(4,Pin.OUT)
while True:
    T_value = T.read() #will read the value of the Pin
    if T_value < 500: #when touched
        print("Pin Touched")
        A.on() #will stay on as long as if gets executed, does not need delay
    else:
        A.off() #when if loop is not executed
        print("Not Touched")
    print(T_value) #will always show the value of T_value
    time.sleep(0.2)

#Trying with a pattern
from machine import Pin, TouchPad
import time
T = TouchPad(Pin(12))
A = Pin(4,Pin.OUT)
B = Pin(5,Pin.OUT)
while True:
    T_value = T.read()
    if T_value < 500:
        print("Pin Touched")
        A.on()
    else:
        A.off()
        B.on()
        print("Not touched")
        time.sleep(0.5)
        B.off()
    print(T_value)
    time.sleep(0.2)
  
#Using a push button
from machine import Pin
import time
A = Pin(4,Pin.IN,Pin.PULL_UP) #Pin.PULL_UP - ESP32 with 3.3V - becomes 1, then when button is pressed, 1 gets pulled to 0
while True:
    print(A.value())
    time.sleep(0.2) #output will come as 1 and whenever the button is pressed, it becomes 0

