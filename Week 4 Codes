#Push button with output
from machine import Pin
import time
A = Pin(4,Pin.IN,Pin.PULL_UP)
B = Pin(5,Pin.OUT)
C = Pin(21,Pin.OUT)
D = Pin(19,Pin.OUT)
E = Pin(23,Pin.OUT)
while True:
    print(A.value())
    Z = A.value()
    if Z == 0:
        B.on()
        time.sleep(0.07)
        C.on()
        time.sleep(0.07)
        D.on()
        time.sleep(0.07)
        E.on()
    else:
        B.off()
        time.sleep(0.07)
        C.off()
        time.sleep(0.07)
        D.off()
        time.sleep(0.07)
        E.off()
    time.sleep(0.2)

#2 push buttons and 2 leds
from machine import Pin
import time
A = Pin(4,Pin.IN,Pin.PULL_UP)
B = Pin(15,Pin.IN,Pin.PULL_UP)
Y = Pin(21,Pin.OUT)
G = Pin(23,Pin.OUT)
while True:
    print(A.value())
    print(B.value())
    X = A.value()
    Z = B.value()
    if X == 0:
        Y.on()
        print("LED 1 ON")
        time.sleep(0.4)
    if Z == 0:
        G.on()
        print("LED 2 ON")
        time.sleep(0.4)
    else:
        Y.off()
        G.off()
    time.sleep(0.2)


        
