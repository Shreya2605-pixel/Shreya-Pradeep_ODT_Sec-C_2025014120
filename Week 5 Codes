# Using an output for IR
from machine import Pin
import time
B = Pin(19,Pin.OUT)
ir = Pin(15,Pin.IN,Pin.PULL_UP)
while True :
    v = ir.value()
    print(v)
    time.sleep(0.5)
    if v == 0:
        B.on()
        time.sleep(0.5)
        B.off()
        
# Project 1 (done in class, use 1 input and 1 or more outputs)
from machine import Pin
import time
import neopixel
import random
B = Pin(27,Pin.OUT)
ir = Pin(15,Pin.IN,Pin.PULL_UP)
neo = neopixel.NeoPixel(Pin(4),16)
while True :
    v = ir.value()
    time.sleep(0.5)
    if v == 1:
        for i in range(16):
            a = random.randint(0,256)
            b = random.randint(0,256)
            c = random.randint(0,256)
            neo[i] = (a,b,c)
            time.sleep(0.003)
            neo.write()
            neo[i] = (0,0,0)
    else :
        B.on()
        time.sleep(0.3)
        B.off()
    print(v)
        
