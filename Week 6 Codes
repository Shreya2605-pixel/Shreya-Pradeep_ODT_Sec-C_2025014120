# To print numbers from 1 to ... based on the no. of times 1st button is pressed, counter no. will increase, if 2nd button is pressed, counter no. will decrease
# And when both buttons are pressed, reset the counter
from machine import Pin
import time
S = Pin(15,Pin.IN,Pin.PULL_UP)
B = Pin(4,Pin.IN,Pin.PULL_UP)
C = 0
while True:
    if S.value() == 0 and B.value() == 0:
        C = 0
        print(C)
    elif S.value() == 0:
        C = C+1
        print(C)
    elif  B.value() == 0:
        C = C-1
        print(C)
    time.sleep(0.2)

# As the button gets pressed, the counter increases
# As the counter increases, the neopixels should light up one by one
from machine import Pin
import time
import neopixel
A = Pin(4,Pin.IN,Pin.PULL_UP)
neo = neopixel.NeoPixel(Pin(12),16)
C = 0
while True:
    if A.value() == 0: #when button is pushed, value becomes 0
        C = C+1 #counter increases as value becomes 0
        neo[C]=(255,0,255) #neo[c]- neo[counter]
        print(C)
        time.sleep(0.2)
        neo.write() #lights up the led
        
