# 2 push buttons - when 1st one is pressed, print "only button 1 pressed". when the 2nd button is pressed, print "only button 2 pressed"
from machine import Pin
import time
A = Pin(4,Pin.IN,Pin.PULL_UP)
B = Pin(15,Pin.IN,Pin.PULL_UP)
while True:
    if A.value() == 0 and B.value() == 0:
        print("Both buttons pressed.")
    elif A.value() == 0:
        print("Only button 1 pressed.")
    elif B.value() == 0:
        print("Only button 2 pressed.")
    time.sleep(0.2)

