# Same code as above but randomly generating the colours of the leds
from machine import Pin
import time
import neopixel
import random
A = Pin(4,Pin.IN,Pin.PULL_UP)
B = Pin(15,Pin.IN,Pin.PULL_UP)
neo = neopixel.NeoPixel(Pin(12),16)
C = 0
while True:
    if A.value() == 0: 
        C = C+1 
        a = random.randint(0,256)
        b = random.randint(0,256)
        c = random.randint(0,256)
        neo[C] = (a,b,c)
        print(C)
        time.sleep(0.2)
        neo.write() 
    if B.value() == 0:
        C = C-1 
        neo[C+1]=(0,0,0)
        print(C)
